{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "built",
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strictPropertyInitialization": false,
		"declaration": false,
		"allowJs": false,
		"checkJs": false,
		"types": [
			"node"
		],
		"noEmitOnError": true
	},
	"include": [
		"src/**/*.ts"
	]
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"outDir": "built",
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strictPropertyInitialization": false,
		"declaration": true,
		"allowJs": true,
		"checkJs": false,
		"types": [
			"node"
		],
		"noEmitOnError": true
	},
	"include": [
		"src/**/*.ts",
		"exports/**/*.ts",
		"migration/**/*.js"
	]
}

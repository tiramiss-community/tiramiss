  "discoveryCases": [
    {
      "id": "oauth-client-discovery-json-basic",
      "contentType": "application/json",
      "json": {
        "client_id": "{{origin}}/client",
        "client_uri": "{{origin}}/",
        "redirect_uris": [
          "/callback"
        ],
        "client_name": "Fake client",
        "logo_uri": "/logo.png"
      }
    },
    {
      "id": "oauth-client-discovery-json-relative",
      "contentType": "application/json",
      "json": {
        "client_id": "{{origin}}/client",
        "client_uri": "{{origin}}/",
        "redirect_uris": [
          "callback",
          "/callback?x=1",
          "#callback"
        ],
        "logo_uri": "logo.png"
      }
    },
    {
      "id": "oauth-client-discovery-json-header-merge",
      "contentType": "application/json",
      "json": {
        "client_id": "{{origin}}/client",
        "client_uri": "{{origin}}/",
        "redirect_uris": [
          "/callback",
          "/callback"
        ]
      },
      "link": "</header>; rel=\"redirect_uri\", </ignored>; rel=\"alternate\", </callback>; rel=\"redirect_uri\""
    },
    {
      "id": "oauth-client-discovery-json-no-redirect",
      "contentType": "application/json",
      "json": {
        "client_id": "{{origin}}/client",
        "client_uri": "{{origin}}/",
        "redirect_uris": []
      }
    },
    {
      "id": "oauth-client-discovery-json-filter-types",
      "contentType": "application/json",
      "json": {
        "client_id": "{{origin}}/client",
        "client_uri": "{{origin}}/",
        "redirect_uris": [
          null,
          1,
          {},
          "/callback"
        ],
        "client_name": 10,
        "logo_uri": 10
      }
    },
    {
